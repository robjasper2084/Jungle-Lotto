{
  "name": "lottominded-ultra-site",
  "private": true,
  "scripts": {
    "check:home": "node scripts/validate-home-page.mjs",
    "check:site": "node scripts/validate-site.mjs",
    "games:sync": "node scripts/validate-game-manifest.mjs",
    "games:validate": "node scripts/validate-game-manifest.mjs --check",
    "release:audit": "npm run games:validate && node scripts/validate-release-gates.mjs",
    "release:signoff:capture": "node scripts/capture-release-signoff.mjs",
    "staging:build": "npm run games:validate && node scripts/build-staging.mjs",
    "staging:serve": "node scripts/serve-site.mjs dist-staging 8143",
    "staging:test": "npm run staging:build && node scripts/test-staging-static.mjs && node scripts/run-staging-tests.mjs",
    "source-test:build": "node scripts/build-source-test.mjs",
    "routes:test": "npm run staging:build && npm run source-test:build && node scripts/run-route-tests.mjs",
    "backend:test": "node scripts/test-secure-backend.mjs",
    "account:architecture:test": "node scripts/test-secure-backend.mjs",
    "arcade-pilot:test": "playwright test --config=playwright.arcade-pilot.config.cjs",
    "arcade-pilot:capture": "node scripts/capture-arcade-pilot.mjs",
    "baseline:capture": "node scripts/capture-visual-baseline.mjs",
    "trivia:test": "node --test games/lottomind-trivia/tests/*.test.mjs",
    "trivia:capture": "node scripts/capture-trivia-vault.mjs",
    "trivia:questions": "node scripts/manage-trivia-questions.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
