---
import '../styles/cfiles.css';
import { href, canonical } from '../utilities/paths';
import { serialize } from '../utilities/serialize';
import seed from '../cfiles/seed.json';
const { title='C-Files · UFO & strange event research', active='News' }=Astro.props;
const root=href('c-files/');
const links=[['News',''],['C-Files','archive/'],['Map','map/'],['Sources','sources/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | GOTHTECHNOLOGY</title><meta name="description" content="Source-linked UFO and strange-event news, historical case files, and moderated community evidence. A research section of GothTechnology."/><link rel="canonical" href={new URL(Astro.url.pathname,canonical())}/></head>
<body class="cf-body"><a class="cf-skip" href="#cf-main">Skip to content</a>
<header class="cf-header"><a class="cf-logo" href={root}>C-FILES</a><a class="cf-parent" href={href()}>GOTHTECHNOLOGY <span aria-hidden="true">↗</span></a><nav aria-label="C-Files navigation">{links.map(([label,path])=><a href={root+path} aria-current={active===label?'page':undefined}>{label}</a>)}</nav><div class="cf-account-nav"><a class="cf-button cf-secondary" href={root+'account/'} data-account-link>Sign in</a><a class="cf-button" href={root+'submit/'}>Submit a report</a></div></header>
<p class="cf-service" data-service role="status">Source archive · checking contribution service…</p>
<main id="cf-main" tabindex="-1"><slot/></main>
<footer class="cf-footer"><a href={href()}>GOTHTECHNOLOGY <span>/ C-FILES</span></a><p>Open records. Careful conclusions.</p><a href={root+'sources/#method'}>How review works</a><a href={root+'account/'}>Your reports</a><a href={root+'moderation/'}>Moderation</a></footer>
<script id="cf-config" type="application/json" set:html={serialize({root,seed,api:root+'api/'})}/>
<script>import { initCFiles } from '../cfiles/app';initCFiles();</script>
</body></html>
