---
import type { Product } from '../commerce/types';
import { media } from '../utilities/paths';
import EquipmentArt from './EquipmentArt.astro';
const { product, priority = false, campaign = false } = Astro.props as {product:Product;priority?:boolean;campaign?:boolean};
const special = campaign && product.demo ? product.handle.includes('hoodie') ? 'media/hero.webp' : product.handle.includes('charm') ? 'media/charm-campaign.webp' : null : null;
const image = product.images[0];
const atlasTiles: Record<string, number> = {'night-protocol-hoodie':0,'detroit-2084-shirt':1,'gothtechnology-luggage-charm':3,'static-saints-patch-set':4};
const atlasTile = product.demo && (campaign || !image) ? atlasTiles[product.handle] ?? -1 : -1;
const silhouettes: Record<string, string> = {
  'detroit-2084-shirt': 'M64 34 40 42 14 84l34 18 8-20v128h128V82l8 20 34-18-26-42-24-8c-8 26-104 26-112 0Z',
  'static-saints-patch-set': 'm62 34 34 20v40l-34 20-34-20V54l34-20Zm110 0 34 20v40l-34 20-34-20V54l34-20Zm-52 94 34 20v40l-34 20-34-20v-40l34-20Z',
  'cyber-cathedral-art-print': 'M38 20h164v208H38ZM50 32h140v184H50Zm20 180V96l50-58 50 58v116m-70 0V108l20-26 20 26v104',
  'black-signal-digital-pack': 'M42 32h156v176H42Zm12 12h132v108H54ZM70 176h100M86 191h68',
};
const drawing = product.handle.includes('desk-mat') ? 'M12 64h216v122H12ZM24 76h192v98H24ZM60 80v90m40-90v90m40-90v90m40-90v90M28 112h184m-184 32h184' : silhouettes[product.handle] || 'M30 65h180v140H30ZM30 65 120 24l90 41M120 65v140M45 112h60';
---
<div class:list={['product-media', special && 'campaign-media', !image && 'concept-media']}>
  {atlasTile >= 0 ? <EquipmentArt tile={atlasTile} alt={`${product.title} — generated studio concept, not final product photography`}/> : image ? <img src={media(special || image.src)} alt={special ? `${product.title} — generated campaign concept based on the owner reference` : image.alt} width="840" height="840" loading={priority ? 'eager' : 'lazy'} decoding="async" /> :
    <div class="concept-drawing" role="img" aria-label={`${product.title}. Product photography is not yet supplied.`}>
      <svg viewBox="0 0 240 240" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d={drawing}/><path d="M100 123h40m-20-20v40"/></svg>
      <span class="mono">GOTHTECHNOLOGY</span><small>DESIGN STUDY / IMAGE PENDING</small>
    </div>}
  {product.demo && <span class="media-caption">{atlasTile >= 0 || special ? 'CAMPAIGN CONCEPT' : image ? 'SUPPLIED REFERENCE' : 'CONCEPT DISPLAY'}</span>}
</div>
