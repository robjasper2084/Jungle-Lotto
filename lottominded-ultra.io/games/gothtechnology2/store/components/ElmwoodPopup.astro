---
import {href} from '../utilities/paths';
import Icon from './Icon.astro';
const explorer=true;
const game=href('arcade/elmwood-explorer/elmwood.html');
---
<section class="elmwood-feature section" id="elmwood" aria-labelledby="elmwood-feature-title">
 <button class="elmwood-poster" type="button" data-open-elmwood aria-label="Play Elmwood Cemetery" aria-haspopup="dialog" aria-controls="elmwood-dialog"><img src={href(explorer?'media/elmwood-explorer-preview.png':'media/elmwood-cemetery-preview.png')} alt={explorer?'Elmwood Cemetery chapel and landscape in the original exploration game':'Riding through Elmwood Cemetery in Ride Detroit'} width="1280" height="720" loading="lazy"/><span><Icon name="play" size={20}/> EXPLORE ELMWOOD</span></button>
 <div class="elmwood-copy"><p class="mono gold">DIGITAL STATIC / DETROIT EXPLORATION</p><h2 id="elmwood-feature-title">ELMWOOD<br/><span>{explorer?'EXPLORE THE GROUNDS.':'AFTER THE CITY.'}</span></h2><p>{explorer?'Explore Elmwood Cemetery’s garden paths and historic architecture. Ride through the grounds, inspect landmarks, and change the season and light.':'Ride Detroit’s Elmwood garden lanes with your chosen rider and optional Boerboel companion. Land clean hops and tricks to build your shared game discount points.'}</p><button class="button" type="button" data-open-elmwood aria-haspopup="dialog" aria-controls="elmwood-dialog">Play Elmwood <Icon name="play" size={16}/></button><p class="elmwood-note">{explorer?'Keyboard and touch controls · Free to explore':'Keyboard, touch & gamepad · Sound starts off · No purchase required'}</p>{!explorer && <div class="elmwood-reward" data-underground-reward><strong><span data-reward-score>0</span> points · <span data-reward-percent>0%</span> discount preview</strong><span data-reward-next>12,000 points to 5%</span><small>All games add together. Maximum 20%. Preview only; not redeemable yet.</small></div>}<small>A playable interpretation; some landmark dimensions and landscape placements are estimates.</small></div>
</section>
<dialog id="elmwood-dialog" aria-labelledby="elmwood-title" aria-describedby="elmwood-help" data-elmwood-url={game} data-reward-game={explorer?undefined:'elmwood'}>
 <div class="elmwood-heading"><h2 id="elmwood-title">DIGITAL STATIC / ELMWOOD</h2><button class="button secondary" type="button" data-close-dialog autofocus>Close game <Icon name="close" size={16}/></button></div>
 <div class="elmwood-stage"><div data-elmwood-host></div><div class="elmwood-loading" data-elmwood-loading><p role="status" data-elmwood-status>Loading Elmwood’s landscape…</p><button class="button secondary" type="button" data-elmwood-retry hidden>Retry game</button></div></div>
 <div class="elmwood-footer">{!explorer && <div class="elmwood-live-reward" data-underground-reward><strong><span data-reward-score>0</span> points · <span data-reward-percent>0%</span> preview</strong><span>All games · Not redeemable yet</span></div>}<p id="elmwood-help">{explorer?'Choose Ride Elmwood to begin.':'Choose Let’s ride to begin.'} WASD / arrows move · Space hops · Shift crouches · P pauses · R recovers · Esc closes popup.</p><a class="text-link" href={game} target="_blank" rel="noopener">Open full page <Icon size={14}/></a><small>{explorer?'Use Ride settings for riders, landmarks, season and time of day. Closing the popup stops the game.':'Clean hops and successful tricks earn points. Closing the popup saves earned points and stops the game.'}</small></div>
</dialog>
<script>import {initElmwoodPopup} from '../ui/elmwood-popup';initElmwoodPopup();</script>
<style>
.elmwood-reward{display:grid;gap:6px;margin:18px 0;padding:14px 0;border-block:1px solid var(--rule);font-size:14px}.elmwood-reward>span{color:var(--goth-cyan)}.elmwood-live-reward{width:100%;display:flex;justify-content:space-between;gap:8px;font-size:12px}.elmwood-live-reward strong{color:var(--goth-cyan)}
.elmwood-feature{display:grid;grid-template-columns:1fr 1fr;gap:0;background:#090e0e;border-block:1px solid var(--rule)}.elmwood-poster{position:relative;padding:0;min-height:350px;border:1px solid var(--rule);background:#101a18;color:var(--goth-gold);overflow:hidden;cursor:pointer}.elmwood-poster img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}.elmwood-poster span{position:absolute;bottom:20px;left:20px;display:flex;align-items:center;gap:12px;padding:12px 16px;background:#050909e8;border:1px solid var(--goth-gold);font:12px var(--mono)}.elmwood-copy{padding:28px 36px}.elmwood-copy h2{font:clamp(30px,3vw,46px)/1.12 var(--display);margin:14px 0;color:var(--goth-gold)}.elmwood-copy h2 span{color:var(--goth-cyan)}.elmwood-copy>p{max-width:550px;font-size:16px;line-height:1.65}.elmwood-copy .mono{font-size:12px}.elmwood-copy .button{margin-top:10px}.elmwood-copy .elmwood-note,.elmwood-copy small{font-size:12px;color:#bab49f;line-height:1.6}
#elmwood-dialog{width:min(1280px,calc(100vw - 32px));height:min(880px,calc(100dvh - 32px));max-width:none;max-height:calc(100dvh - 32px);padding:0;overflow:hidden;border:1px solid var(--goth-gold);background:#070d0e;color:var(--goth-gold)}#elmwood-dialog[open]{display:grid;grid-template-rows:auto minmax(0,1fr) auto}#elmwood-dialog::backdrop{background:#000e}.elmwood-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 20px;border-bottom:1px solid var(--rule)}.elmwood-heading h2{font:clamp(16px,1.6vw,24px)/1.2 var(--display);margin:0}.elmwood-heading .button{flex-shrink:0;min-height:44px}.elmwood-stage{position:relative;min-height:0;background:#101a18}[data-elmwood-host]{height:100%;width:100%}:global(#elmwood-dialog iframe){display:block;width:100%;height:100%;border:0}.elmwood-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20px;background:#101a18}.elmwood-loading[hidden]{display:none}.elmwood-footer{padding:10px 20px;display:flex;align-items:center;justify-content:space-between;gap:8px 20px;flex-wrap:wrap;border-top:1px solid var(--rule)}.elmwood-footer p{flex:1;min-width:200px;font-size:12px;line-height:1.5;margin:0}.elmwood-footer small{font-size:11px;color:#c1b99e;width:100%}
@media(max-width:700px){.elmwood-feature{grid-template-columns:1fr}.elmwood-poster{height:220px;min-height:220px}.elmwood-copy{padding:24px 0 0}.elmwood-copy h2{font-size:32px}#elmwood-dialog{width:100vw;height:100dvh;max-width:100vw;max-height:100dvh;border:0}.elmwood-heading{padding:8px 12px;gap:10px}.elmwood-heading .button{padding:8px;font-size:11px}.elmwood-footer{padding:8px 12px}.elmwood-footer p{font-size:11px}.elmwood-footer small{display:none}}
</style>
