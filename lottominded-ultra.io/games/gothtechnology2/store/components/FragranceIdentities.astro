---
import {fragranceCollection} from '../content/fragrance';
---
<section class="fragrance-identities" id="fragrance-labels" aria-label="Pictured fragrance labels">
  <p class="mono gold">THE ILLUSTRATED COLLECTION</p>
  <h2>Explore the pictured scents.</h2>
  <p class="fragrance-note">Names as shown in the supplied artwork. Ingredients, scent formulas, bottle volume, and the final assortment are not yet confirmed.</p>
  <details><summary>View all {fragranceCollection.identities.length} label names</summary><ul>{fragranceCollection.identities.map(name=><li>{name}</li>)}</ul></details>
</section>
<style>
 .fragrance-identities{margin-block:28px;padding-block:24px;border-block:1px solid var(--rule);scroll-margin-top:100px}.fragrance-identities h2{font-size:clamp(26px,3vw,36px);line-height:1.15;margin:10px 0 18px}.fragrance-note{max-width:75ch;margin:0 0 16px;font:15px/1.7 Arial,sans-serif;color:#c8c3b5}.fragrance-identities summary{min-height:44px;padding:12px 0;cursor:pointer;font:14px/1.5 Arial,sans-serif;color:#e8c777}.fragrance-identities ul{display:flex;flex-wrap:wrap;gap:10px;padding:12px 0 0;list-style:none}.fragrance-identities li{padding:12px 16px;border:1px solid var(--rule);font:16px/1.4 Arial,sans-serif;color:var(--goth-cream);background:#0c100f}
</style>
