---
import {href} from '../utilities/paths';
---
<section class="transmission-wall section" id="transmission-wall" aria-labelledby="wall-title" data-transmission-wall>
  <div class="wall-heading"><span class="section-number">TRANSMISSION WALL / LOCAL NODE</span><h2 id="wall-title">ARMORY <em>LIVE</em><span aria-hidden="true">●</span></h2><p>Your games. Your equipment. Your signal.</p><p class="wall-scope">This browser only. No public feed is connected. Activity is never uploaded.</p><a class="text-link" href={href('#underground-rewards')}>Enter the arcade →</a></div>
  <div class="wall-console"><div class="wall-console-heading"><span>NODE / THIS DEVICE</span><span data-wall-state>STANDBY</span></div><ol data-wall-events aria-label="Your recent activity"></ol><p data-wall-empty>Awaiting your first transmission. Enable your local wall, then play a game, save equipment, or finish a film.</p><p class="sr-only" data-wall-status role="status"></p>
    <details><summary>My wall settings</summary><form data-wall-settings><label class="wall-opt-in"><input type="checkbox" name="enabled"/> Record my activity on this device</label><label for="wall-handle">Optional handle · letters, numbers, _ or -</label><div class="wall-form-row"><input id="wall-handle" name="handle" maxlength="20" pattern="[A-Za-z0-9_-]{2,20}" placeholder="YOUR SIGNAL" autocomplete="off"/><button class="button secondary" type="submit">Save settings</button></div><p>Leave your handle blank to appear as YOU. No names, locations, customer orders, or past activity are imported.</p><button class="text-button" type="button" data-wall-clear>Clear my activity</button></form></details>
  </div>
</section>
<style>
 .transmission-wall{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(24px,5vw,84px);background:radial-gradient(ellipse at 90% 40%,#14262566,transparent 60%),#070a0b;border-block:1px solid var(--rule)}
 .wall-heading h2{font-size:clamp(42px,5vw,78px);line-height:1.05;margin:20px 0}.wall-heading em{color:var(--cyan,#75dce6);font-style:normal}.wall-heading h2 span{font:12px sans-serif;color:#75dce6;vertical-align:top;margin-left:12px}.wall-heading p,.wall-console p{font:15px/1.65 Arial,sans-serif}.wall-scope{max-width:38ch;color:#a8b5b8}.wall-console{min-width:0;border:1px solid var(--rule);padding:clamp(16px,2.5vw,32px);background:#030707b3}.wall-console-heading{display:flex;justify-content:space-between;gap:12px;font:11px var(--mono);letter-spacing:.13em;color:#75dce6;border-bottom:1px solid var(--rule);padding-bottom:16px}.wall-console ol{padding:0;margin:0;list-style:none}.wall-console :global(li){display:grid;grid-template-columns:52px 1fr;gap:16px;padding:18px 0;border-bottom:1px solid #283335;font:14px/1.6 Arial,sans-serif;overflow-wrap:anywhere}.wall-console :global(time){color:#779299;font:12px/1.8 var(--mono)}.wall-console :global(strong){color:#e5cd90;font-size:12px;letter-spacing:.08em}.wall-console details{border-top:1px solid var(--rule);margin-top:20px}.wall-console summary{min-height:48px;padding:16px 0;cursor:pointer;font:12px var(--mono);text-transform:uppercase}.wall-console label{display:block;font:14px/1.6 Arial,sans-serif;margin:12px 0 6px}.wall-opt-in{display:flex!important;align-items:center;gap:12px;min-height:44px}.wall-opt-in input{width:20px;height:20px}.wall-form-row{display:flex;gap:8px}.wall-form-row input{width:100%;min-width:0;min-height:44px}.wall-console button{min-height:44px}.wall-console form p{font-size:12px;color:#a8b5b8}.wall-console [hidden]{display:none}
 @media(max-width:760px){.transmission-wall{grid-template-columns:1fr}.wall-form-row{flex-wrap:wrap}.wall-console-heading{font-size:10px}}
</style>
