  menu: 'M4 6h16M4 12h16M4 18h16', search: 'm16 16 5 5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
  bag: 'M5 7h14l1 14H4L5 7Zm3 0V5a4 4 0 0 1 8 0v2', play: 'm8 4 12 8-12 8V4Z',
  plus: 'M12 4v16M4 12h16', minus: 'M4 12h16', sound: 'm11 4-6 5H2v6h3l6 5V4Zm5 3a7 7 0 0 1 0 10m3-13a11 11 0 0 1 0 16',
