---
import { config } from '../config';
import { launchOwner } from '../content/launch';
import { disconnectedMessage } from '../state/subscription';
import { href } from '../utilities/paths';
interface Props { id: string; loadout?: boolean }
const { id, loadout = false } = Astro.props;
---
<form id={id} data-subscription-form data-loadout-alert={loadout ? 'true' : undefined}>
  <label for={id+'-email'}>Email address</label>
  <div class="email-row">
    <input type="email" id={id+'-email'} name="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required aria-describedby={id+'-status'}/>
    <button class="button" type="submit">Get Launch Alert</button>
  </div>
  <label class="consent-label"><input type="checkbox" name="consent" required aria-describedby={id+'-status'}/>I agree to receive GOTHTECHNOLOGY launch emails and can unsubscribe at any time.</label>
  <p class="form-status" id={id+'-status'} role="status" aria-live="polite">{config.newsletterEndpoint && launchOwner.subscriptionApproved ? 'Your consent is required. See the privacy notice before submitting.' : disconnectedMessage}</p>
  <p class="form-privacy"><a href={href('privacy/')}>Privacy & your data</a>. Saving a loadout does not reserve stock or place an order.</p>
</form>
