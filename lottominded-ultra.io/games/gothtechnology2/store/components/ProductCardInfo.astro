---
import type {Product} from '../commerce/types';
import {labelsFor, type ConversionMode} from '../commerce/mode';
import {formatMoney} from '../commerce/money';
import {href} from '../utilities/paths';
import GameDiscountPrice from './GameDiscountPrice.astro';
import Icon from './Icon.astro';
const {product,mode}=Astro.props as {product:Product;mode:ConversionMode};
const labels=labelsFor(mode),pricePending=product.price.amount<=0;
---
<div class="price-line"><strong><small>{pricePending ? 'Price' : labels.price}</small>{pricePending ? 'Pending' : formatMoney(product.price)}</strong><span>{mode === 'interest' ? 'Concept Preview' : product.variants.some(v => v.available) ? 'Available' : 'Unavailable'}</span></div>
{mode==='interest' && !pricePending && <GameDiscountPrice price={product.price}/>}
<p class="color-line"><span class="swatch" aria-hidden="true"></span>{product.colors.join(' / ')}</p>
{product.information.materials && <p class="product-verified-detail">{product.information.materials}</p>}
<div class="card-actions"><a class="text-link" href={href(`products/${product.handle}/`)}>View Product <Icon/></a>{!pricePending && (product.variants.length > 1 ? <button class="button compact" data-quick-view={product.handle} aria-label={`Choose Options for ${product.title}`}>Choose Options</button> : <button class="button compact" data-save-product={product.handle} aria-label={`${labels.save}: ${product.title}`}>{labels.save}</button>)}</div>
