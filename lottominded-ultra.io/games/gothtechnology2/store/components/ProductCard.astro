---
import type { Product } from '../commerce/types';
import ProductMedia from './ProductMedia.astro';
import ProductCardInfo from './ProductCardInfo.astro';
import { buildProvider } from '../commerce/provider';
import { conversionMode } from '../commerce/mode';
import { href } from '../utilities/paths';
const { product, compact = false } = Astro.props as {product:Product;compact?:boolean};
const mode = conversionMode(await buildProvider.getProducts());
const shortTitles:Record<string,string> = {'night-protocol-hoodie':'Knight Protocol Hoodie','boogeyman-graphic-hoodie':'Boogeyman Hoodie','detroit-2084-shirt':'Detroit 2084 Tee','black-signal-beanie':'Detroit Skyline Beanie','gothtechnology-luggage-charm':'LottoMind Charm // 001','static-saints-patch-set':'Detroit Patch Study'};
const displayTitle = compact ? shortTitles[product.handle] || product.title : product.title;
---
<article class:list={['product-card',compact && 'compact-product']} data-product-card data-handle={product.handle}>
  <a class="product-image-link" href={href(`products/${product.handle}/`)} aria-label={`View ${product.title}`}><ProductMedia product={product} campaign/></a>
  <div class="product-card-copy"><p class="mono muted">{product.collection.replaceAll('-', ' ')}</p>
    <h3><a href={href(`products/${product.handle}/`)}>{displayTitle}</a></h3>
    {compact ? <details class="product-card-details">
      <summary aria-label={`Pricing and details for ${product.title}`}>Pricing &amp; details</summary>
      <div class="product-card-details-body"><ProductCardInfo product={product} mode={mode}/></div>
    </details> : <ProductCardInfo product={product} mode={mode}/>}
  </div>
</article>

<style>
  :global(#featured .featured-equipment){align-items:start}
  :global(#featured .product-card-copy h3){min-height:2.7em}
  .product-card-details{margin-top:auto;border-top:1px solid var(--rule);border-bottom:0;min-width:0}
  .product-card-details>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;padding:12px 0;color:var(--goth-gold-light);font:12px/1.5 var(--mono);letter-spacing:.025em;list-style:none}
  .product-card-details>summary::-webkit-details-marker{display:none}
  .product-card-details>summary::after{content:"";width:7px;height:7px;flex:none;margin-right:3px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:rotate(45deg)}
  .product-card-details[open]>summary{border-bottom:1px solid var(--rule);color:var(--goth-cream)}
  .product-card-details[open]>summary::after{transform:rotate(225deg)}
  .product-card-details>summary:hover{color:var(--goth-cream)}
  .product-card-details>summary:focus-visible{outline:2px solid var(--goth-cyan);outline-offset:3px}
  .product-card-details-body{padding:16px 0 4px;min-width:0}
  .product-card-details :global(.game-price-preview p){color:var(--goth-cyan)}
</style>
