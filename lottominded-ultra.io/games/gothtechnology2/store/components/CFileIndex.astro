---
import seed from '../cfiles/seed.json';
import { eventTypes,evidenceStatuses } from '../cfiles/types';
import { href } from '../utilities/paths';
const { compact=false }=Astro.props;
---
<section class="cf-index" aria-labelledby="archive-title"><div class="cf-index-heading"><h2 id="archive-title">Open the files.</h2><p class="cf-muted" data-case-count>{seed.length} historical source records</p></div>
<form class="cf-filters" role="search" aria-label="Search case files"><label class="cf-search">Search cases<input name="q" type="search" placeholder="Keyword, location, source…" maxlength="160"/></label><label>Year<select name="year" aria-label="Year"><option value="">All years</option>{[...new Set(seed.map(c=>c.year))].sort((a,b)=>b-a).map(y=><option value={y}>{y}</option>)}</select></label><label>Event type<select name="type" aria-label="Event type"><option value="">All event types</option>{eventTypes.map(t=><option>{t}</option>)}</select></label><label>Evidence status<select name="status" aria-label="Evidence status"><option value="">All evidence statuses</option>{evidenceStatuses.map(s=><option>{s}</option>)}</select></label>{!compact&&<label>Witness<select name="witness" aria-label="Witness"><option value="">All witnesses</option>{['Civilian','Military','Pilot','Astronomer','Other'].map(w=><option>{w}</option>)}</select></label>}<button type="reset" class="cf-text-button">Reset</button></form>
<div class="cf-table-scroll"><table class="cf-table"><thead><tr><th>Case</th><th>Location</th><th>Year</th><th>Evidence</th><th><span class="cf-sr">Open</span></th></tr></thead><tbody data-case-rows>{seed.map(c=><tr><td><a href={href('c-files/cases/'+c.id+'/')}>{c.title}</a></td><td>{c.location}</td><td>{c.year}</td><td class="cf-gold">{c.credibility}</td><td aria-hidden="true">↗</td></tr>)}</tbody></table></div><p class="cf-empty" data-case-empty hidden>No matching files. Try another term or reset the filters.</p><p class="cf-caption">Evidence status describes the record, not proof of an extraordinary origin.</p></section>
