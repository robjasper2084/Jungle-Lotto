---
import Shell from '../layouts/Shell.astro';
import ProductCard from '../components/ProductCard.astro';
import EquipmentArt from '../components/EquipmentArt.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { buildProvider } from '../commerce/provider';
import { href } from '../utilities/paths';
import { formatMoney } from '../commerce/money';
const products = await buildProvider.getProducts();
const drop = products.find(p => p.handle === 'night-protocol-hoodie') || products[0];
const cases = [
  {name:'Apparel',url:'shop/?category=Apparel',tile:0},
  {name:'Accessories',url:'shop/?category=Accessories',tile:3},
  {name:'Collectibles',url:'shop/?category=Collectibles',tile:5},
  {name:'Digital bundles',url:'collections/black-signal/',tile:null},
];
const signals = [
  {name:'The Analog',collection:'black-signal'},
  {name:'The Disciples',collection:'night-protocol'},
  {name:'The Observers',collection:'static-saints'},
  {name:'The Null',collection:'cyber-cathedral'},
];
---
<Shell title="The Armory — Equipment for the world after midnight" cinematic>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src={href('media/armory-hero-v2.webp')} srcset={`${href('media/armory-hero-v2-960.webp')} 960w, ${href('media/armory-hero-v2.webp')} 2400w`} sizes="100vw" width="2400" height="900" alt="Campaign concept: the black 313 Detroit hoodie and LottoMind charm on a pedestal inside a dark gothic armory" fetchpriority="high"/>
    <div class="scene-wrap" id="armory-scene" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="system-online">// SYSTEM ONLINE</p>
      <h1 id="hero-title"><span>Equipment</span> <span>for the world</span> <span>after midnight</span></h1>
      <span class="gold-rule" aria-hidden="true"></span>
      <p>Limited apparel, artifacts, collectibles,<br/>and digital transmissions from GOTHTECHNOLOGY.</p>
      <div class="button-row"><a class="button" href="#current-drop">Shop the drop</a><a class="button secondary" href={href('play/')}>Enter the fight</a><button class="button secondary" data-watch-transmission><Icon name="play" size={13}/>Watch transmission</button></div>
    </div>
    <div class="hero-tools"><span class="scene-status" id="scene-status" role="status">Initializing armory</span><button id="scene-pause" aria-pressed="false">Pause motion</button></div>
    <span class="hero-label">001 / CAMPAIGN CONCEPT</span>
  </section>
  <section class="current-drop armory-drop" id="current-drop" aria-labelledby="drop-title">
    <div class="drop-copy"><p class="section-number">DROP 001 //</p><h2 id="drop-title">Night<br/>Protocol</h2><p>The first transmission.<br/>Forged for the hours<br/>when nothing belongs<br/>to the light.</p>
      {drop && <><p class="drop-price"><strong>{formatMoney(drop.price)}</strong></p><div class="button-row"><a class="button" href={href(`products/${drop.handle}/`)}>View product</a><a class="button secondary" href={href('collections/night-protocol/')}>View collection</a></div></>}
    </div>
    <div class="drop-showcase"><figure><EquipmentArt tile={0} alt="Studio concept of the supplied 313 Detroit hoodie, front view"/><figcaption>01 / THE 313 HOODIE</figcaption></figure><figure><EquipmentArt tile={3} alt="Studio concept of the supplied LottoMind charm and gold clasp"/><figcaption>02 / THE EVERYDAY COMPANION</figcaption></figure></div>
    <aside class="drop-telemetry" aria-label="Drop information"><p>DROP INFO</p><dl><dt>001</dt><dd>Night Protocol</dd><dt>Reference</dt><dd>313 / Detroit</dd><dt>Type</dt><dd>Apparel + artifact</dd><dt>Status</dt><dd>{drop?.demo ? 'Demo concept' : 'View product details'}</dd></dl><span class="signal-mark" aria-hidden="true">⌖</span></aside>
  </section>
  <section class="armory-row category-row" id="armory" aria-labelledby="armory-title"><div class="row-heading"><h2 id="armory-title">The<br/>Armory</h2><p>Select your category.<br/>Outfit. Equip. Transmit.</p></div><div class="equipment-cases">{cases.map(item=><a class="equipment-case" href={href(item.url)}>{item.tile!==null ? <EquipmentArt tile={item.tile} alt={`${item.name} — campaign concept`}/> : <div class="digital-case"><img src={href('media/mascot-illustration.webp')} width="1376" height="768" alt="LottoMind digital artwork concept" loading="lazy"/><span aria-hidden="true">TRANSMISSION_001<br/>DIGITAL ARCHIVE</span></div>}<h3>{item.name}</h3></a>)}</div></section>
  <section class="armory-row featured-row" id="featured" aria-labelledby="featured-title"><div class="row-heading"><h2 id="featured-title">Featured<br/>Equipment</h2><p>Demo concepts.<br/>Not final products.</p><span class="signal-mark" aria-hidden="true">✣</span><a class="text-link" href={href('shop/')}>View all equipment <Icon size={18}/></a></div><div class="featured-equipment">{products.slice(0,6).map(product=><ProductCard product={product} compact/>)}</div></section>
  <section class="armory-row signal-row" id="character-vault" aria-labelledby="signal-title"><div class="row-heading"><h2 id="signal-title">Choose<br/>Your Signal</h2><p>Your channel.<br/>Your allegiance.</p><span class="signal-mark" aria-hidden="true">⌖</span><p class="demo-caption">Collection concepts</p></div><div class="signal-grid">{signals.map((signal,i)=><a class="signal-card" href={href(`collections/${signal.collection}/`)}><div class="signal-portrait"><img src={href('media/signal-portals.webp')} style={`--portrait:${i}`} alt={`${signal.name} — fictional fashion collection portrait`} width="2560" height="800" loading="lazy"/></div><h3>{signal.name}</h3></a>)}</div></section>
  <section class="armory-row lookbook-row" id="combat-lookbook" aria-labelledby="lookbook-title"><div class="row-heading"><h2 id="lookbook-title">Combat<br/>Lookbook</h2><p>Field tested.<br/>Night approved.</p><a class="button secondary" href={href('lookbook/')}>View lookbook</a></div><a class="lookbook-strip" href={href('lookbook/')} aria-label="Explore the Combat Lookbook"><img src={href('media/armory-lookbook.webp')} alt="Campaign concepts: Detroit hoodie in an industrial alley, a rear garment view, LottoMind charm on a bag, and embroidered sleeve detail" width="2400" height="500" loading="lazy"/></a></section>
  <section class="armory-row portal-row" id="enter-the-fight" aria-labelledby="portal-title"><div class="row-heading"><h2 id="portal-title">Enter<br/>The Fight</h2><p>The game portal is open.<br/>Step through.</p><a class="button" href={href('play/')}>Launch portal</a></div><div class="portal-display"><a class="portal-art" href={href('play/')} aria-label="Launch GOTHTECHNOLOGY"><img src={href('media/armory-city.webp')} alt="Dark futuristic Detroit city campaign concept" width="2100" height="600" loading="lazy"/><span class="portal-wordmark"><small>GOTHTECHNOLOGY</small><strong>+PLAY</strong><span aria-hidden="true">✣</span></span><span class="portal-corner corner-tl" aria-hidden="true">+</span><span class="portal-corner corner-tr" aria-hidden="true">+</span><span class="portal-corner corner-bl" aria-hidden="true">+</span><span class="portal-corner corner-br" aria-hidden="true">+</span></a><div class="portal-status"><p>// PORTAL STATIC</p><dl><dt>Gateway:</dt><dd>Open</dd><dt>Player:</dt><dd>You</dd><dt>Mission:</dt><dd>Unknown</dd></dl><span class="gt-seal" aria-hidden="true">GT</span><small>No purchase required</small></div></div></section>
  <section class="armory-origin" aria-labelledby="origin-title"><div class="origin-heading"><h2 id="origin-title">Built in Detroit.<br/>Transmitted<br/>worldwide.</h2><span class="gold-rule" aria-hidden="true"></span><p>Origin matters.</p></div><div class="origin-text"><p>GOTHTECHNOLOGY was born in the industrial heart of Detroit. We design at the intersection of function, art, and future ruin.</p><p>Thank you for supporting independent creators and real visions.</p><a class="text-link" href={href('about/')}>Explore the origin <Icon size={14}/></a></div><img src={href('assets/user-stage/detroit-riverfront.webp')} alt="Detroit riverfront and skyline from the original game's stage artwork" width="1600" height="900" loading="lazy"/></section>
  <Newsletter/>
</Shell>
