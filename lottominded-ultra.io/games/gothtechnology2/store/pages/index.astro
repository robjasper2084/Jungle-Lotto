---
import Shell from '../layouts/Shell.astro';
import SignalCards from '../components/SignalCards.astro';
import ProductCard from '../components/ProductCard.astro';
import EquipmentArt from '../components/EquipmentArt.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import CathedralHero from '../components/CathedralHero.astro';
import CampaignFilm from '../components/CampaignFilm.astro';
import { conversionMode } from '../commerce/mode';
import { buildProvider } from '../commerce/provider';
import { href, media } from '../utilities/paths';
import { formatMoney } from '../commerce/money';
const products = await buildProvider.getProducts();
const isDemoMode = conversionMode(products) === 'interest';
const drop = products.find(p => p.handle === 'night-protocol-hoodie') || products[0];
const cases = [
  {name:'Apparel',url:'shop/?category=Apparel',tile:0},
  {name:'Accessories',url:'shop/?category=Accessories',tile:3},
  {name:'Collectibles',url:'shop/?category=Collectibles',tile:5,image:products.find(p => p.handle === 'cyber-cathedral-art-print')?.images[0]},
  {name:'Original Artwork',url:'collections/black-signal/',tile:null},
];
---
<Shell title="The Armory — Equipment for the world after midnight" cinematic>
  <audio id="new-drop-music" data-background-audio loop preload="none" src={href('media/lottomind-vault-174hz-background.mp3')} aria-label="LottoMind Vault 174 Hz background music"></audio>
  <CathedralHero/>
  <section class="trust-strip" aria-label="About the armory"><span>DESIGNED IN DETROIT</span><span>INDEPENDENT CREATIVE WORLD</span><span>FREE FIGHTING GAME</span><span>{isDemoMode ? 'DROP 001 IN DEVELOPMENT' : 'EXPLORE DROP 001'}</span></section>
  <section class="current-drop armory-drop" id="current-drop" aria-labelledby="drop-title" data-story-scene="drop">
    <div class="drop-copy"><p class="section-number">DROP 001 //</p><h2 id="drop-title">Knight<br/> Protocol</h2><p>The first transmission. A Detroit hoodie and everyday companion, connected to the Knight Protocol world.</p>
      {drop && <><p class="drop-price"><span>{isDemoMode ? 'Preview Price' : 'Price'}</span><strong>{formatMoney(drop.price)}</strong></p><div class="button-row"><a class="button" href={href(`products/${drop.handle}/`)}>View the Hoodie</a><a class="button secondary" href={href('collections/night-protocol/')}>Explore Knight Protocol</a></div></>}
    </div>
    <div class="drop-showcase"><figure><EquipmentArt tile={0} alt="Studio concept of the supplied 313 Detroit hoodie, front view"/><figcaption>01 / THE 313 HOODIE</figcaption><button class="material-hotspot" data-inspect-material="embroidery" aria-haspopup="dialog">Inspect embroidery</button></figure><figure><EquipmentArt tile={3} alt="Studio concept of the supplied LottoMind charm and gold clasp"/><figcaption>02 / THE EVERYDAY COMPANION</figcaption><button class="material-hotspot" data-inspect-material="charm" aria-haspopup="dialog">Inspect the charm</button></figure><button class="text-button drop-transmission" data-watch-transmission><Icon name="play" size={13}/>Watch Campaign Film</button></div>
    <aside class="drop-telemetry" aria-label="Drop information"><p>DROP INFO</p><dl><dt>001</dt><dd>Knight Protocol</dd><dt>Reference</dt><dd>313 / Detroit</dd><dt>Type</dt><dd>Apparel + artifact</dd><dt>Status</dt><dd>{isDemoMode ? 'In development' : 'View product details'}</dd></dl><span class="signal-mark" aria-hidden="true">⌖</span></aside>
  </section>

  <section class="armory-row featured-row" id="featured" aria-labelledby="featured-title"><div class="row-heading"><h2 id="featured-title">Featured<br/> Equipment</h2><p>{isDemoMode ? 'Concept Preview. Final production details pending.' : 'Explore the equipment in Drop 001.'}</p><span class="signal-mark" aria-hidden="true">✣</span><a class="text-link" href={href('shop/')}>View all equipment <Icon size={18}/></a></div><div class="featured-equipment">{products.slice(0,6).map(product=><ProductCard product={product} compact/>)}</div></section>
  <CampaignFilm/>
  <section class="armory-row signal-row" id="character-vault" aria-labelledby="signal-title" data-story-scene="signals"><div class="row-heading"><h2 id="signal-title">Choose<br/> Your Signal</h2><p>Four keychain concepts. Each signal connects a collection to a fighter.</p><span class="signal-mark" aria-hidden="true">⌖</span><p class="demo-caption">Luggage Protectors</p></div><SignalCards showGameCharacters={false}/></section>

  <section class="armory-row portal-row" id="enter-the-fight" aria-labelledby="portal-title"><div class="row-heading"><h2 id="portal-title">Enter<br/> The Fight</h2><p>Play the original fighting game for free. No purchase required.</p><a class="button" href={href('play/')}>Play the Game</a></div><div class="portal-display"><a class="portal-art" href={href('play/')} aria-label="Launch GOTHTECHNOLOGY"><img src={href('media/armory-city.webp')} alt="Dark futuristic Detroit city campaign concept" width="2100" height="600" loading="lazy"/><span class="portal-wordmark"><small>GOTHTECHNOLOGY</small><strong>+PLAY</strong><span aria-hidden="true">✣</span></span><span class="portal-corner corner-tl" aria-hidden="true">+</span><span class="portal-corner corner-tr" aria-hidden="true">+</span><span class="portal-corner corner-bl" aria-hidden="true">+</span><span class="portal-corner corner-br" aria-hidden="true">+</span></a><div class="portal-status"><p>// PORTAL STATIC</p><dl><dt>Gateway:</dt><dd>Open</dd><dt>Player:</dt><dd>You</dd><dt>Mission:</dt><dd>Unknown</dd></dl><span class="gt-seal" aria-hidden="true">GT</span><small>No purchase required</small></div></div></section>
  <section class="armory-row lookbook-row" id="combat-lookbook" aria-labelledby="lookbook-title"><div class="row-heading"><h2 id="lookbook-title">Combat<br/> Lookbook</h2><p>Detroit references.<br/> World-building in motion.</p><a class="button secondary" href={href('lookbook/')}>View lookbook</a></div><a class="lookbook-strip" href={href('lookbook/')} aria-label="Explore the Combat Lookbook"><img src={href('media/armory-lookbook.webp')} alt="Campaign concepts: Detroit hoodie in an industrial alley, a rear garment view, LottoMind charm on a bag, and embroidered sleeve detail" width="2400" height="500" loading="lazy"/></a></section>
  <section class="armory-origin" aria-labelledby="origin-title"><div class="origin-heading"><h2 id="origin-title">Designed in Detroit.<br/> Transmitted<br/> worldwide.</h2><span class="gold-rule" aria-hidden="true"></span><p>Origin matters.</p></div><div class="origin-text"><p>Created by Digital Static in Detroit. Sound, underground gaming, and industrial design connect the fighting game to the objects in the armory.</p><p>Thank you for supporting independent creators and real visions.</p><a class="text-link" href={href('about/')}>Explore the origin <Icon size={14}/></a></div><img src={href('assets/user-stage/detroit-riverfront.webp')} alt="Detroit riverfront and skyline from the original game's stage artwork" width="1600" height="900" loading="lazy"/></section>
  <section class="armory-row category-row" id="armory" aria-labelledby="armory-title"><div class="row-heading"><h2 id="armory-title">The<br/> Armory</h2><p>Select your category.<br/> Outfit. Equip. Transmit.</p></div><div class="equipment-cases">{cases.map(item=><a class="equipment-case" href={href(item.url)}>{item.image ? <div class="category-product-art"><img src={media(item.image.src)} alt={item.image.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async"/></div> : item.tile!==null ? <EquipmentArt tile={item.tile} alt={`${item.name} — campaign concept`}/> : <div class="digital-case"><img src={href('media/mascot-illustration.webp')} width="1376" height="768" alt="LottoMind digital artwork concept" loading="lazy"/><span aria-hidden="true">TRANSMISSION_001<br/> DIGITAL ARCHIVE</span></div>}<h3>{item.name}</h3></a>)}</div></section>
  <Newsletter/>
  <dialog id="material-display" class="material-dialog" aria-labelledby="material-title">
    <div class="dialog-heading"><h2 id="material-title">Material study</h2><button class="icon-button" data-close-dialog aria-label="Close material study"><Icon name="close"/></button></div>
    <div class="material-image-wrap"><img id="material-image" alt="" width="1376" height="768"/></div>
    <div class="button-row"><button class="button secondary" data-material-zoom aria-pressed="false">Zoom detail</button><a class="button" data-material-product>View product</a></div>
    <p>Reference artwork, not final product photography. {isDemoMode && 'No orders or payments.'}</p>
  </dialog>
  <div class="portal-transition" aria-hidden="true"><span>Entering the fight</span></div>
</Shell>
<style>
  .category-product-art{position:relative;width:100%;aspect-ratio:1.18;background:#080b0b}
  .category-product-art img{position:absolute;width:100%;height:100%;object-fit:contain}
  @media(max-width:560px){.category-product-art{aspect-ratio:1.1}}
</style>
