---
import Shell from '../../layouts/Shell.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductMedia from '../../components/ProductMedia.astro';
import Icon from '../../components/Icon.astro';
import { buildProvider } from '../../commerce/provider';
import { conversionMode, labelsFor } from '../../commerce/mode';
import ProductDevelopment from '../../components/ProductDevelopment.astro';
import { characters } from '../../content/catalog';
import { formatMoney, precision } from '../../commerce/money';
import { href, media, canonical } from '../../utilities/paths';
export async function getStaticPaths(){return (await buildProvider.getProducts()).map(product=>({params:{handle:product.handle},props:{product}}));}
const { product }=Astro.props;
const products=await buildProvider.getProducts();
const mode=conversionMode(products), isDemoMode=mode==='interest', labels=labelsFor(mode);
const related=products.filter(p=>p.handle!==product.handle && (p.collection===product.collection || p.productType===product.productType)).slice(0,3);
const character=characters.find(c=>c.id===product.characterAssociation);
const schema = [{'@context':'https://schema.org','@type':'Product',name:product.title,description:product.description,image:product.images.map(im=>new URL(media(im.src),canonical()).href),brand:{'@type':'Brand',name:'GOTHTECHNOLOGY'},...(isDemoMode ? {} : {offers:{'@type':'Offer',price:product.price.amount/(10**precision(product.price.currency)),priceCurrency:product.price.currency,url:canonical(`products/${product.handle}/`),availability:product.variants.some(v=>v.available)?'https://schema.org/InStock':'https://schema.org/OutOfStock'}})}, {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Shop',item:canonical('shop/')},{'@type':'ListItem',position:2,name:product.title,item:canonical(`products/${product.handle}/`)}]}];
---
<Shell title={product.seo.title} description={product.seo.description} path={`products/${product.handle}/`} schema={schema} socialImage={product.images[0]?.src}>
  <div class="product-route"><nav class="breadcrumb" aria-label="Breadcrumb"><a href={href('shop/')}>Shop</a><span>/</span><a href={href(`collections/${product.collection}/`)}>{product.collection.replaceAll('-',' ')}</a><span>/</span><span>{product.title}</span></nav>
  <section class="section product-detail" data-product-detail={product.handle}>
    <div class="product-gallery">{product.images.length ? <><div class="gallery-main"><img id="gallery-image" src={media(product.images[0].src)} alt={product.images[0].alt} width="840" height="840" fetchpriority="high"/><span class="media-caption" data-gallery-kind>{product.information.photographyStatus==='approved' ? 'VERIFIED PRODUCT PHOTOGRAPHY' : product.images[0].kind || 'SUPPLIED PRODUCT REFERENCE'}</span><button id="gallery-zoom" aria-pressed="false">Zoom image</button></div><div class="gallery-thumbs" aria-label="Product image views">{product.images.map((im,i)=><button type="button" data-gallery-src={media(im.src)} data-gallery-alt={im.alt} data-gallery-kind={product.information.photographyStatus==='approved' ? 'VERIFIED PRODUCT PHOTOGRAPHY' : im.kind || 'SUPPLIED PRODUCT REFERENCE'} aria-pressed={i===0}><img src={media(im.src)} alt="" width="140" height="85" loading="lazy"/>{im.label}</button>)}</div></> : <ProductMedia product={product} priority/>}
      <div class="model-viewer" data-model={product.model || ''} data-handle={product.handle}><h3>Explore the display.</h3><p class="model-caption">{product.model ? 'Drag, touch, or use the view controls to rotate the product model.' : 'A 2.5D image display, not a garment model. The supplied product gallery remains the reference.'}</p><button class="text-button" data-load-viewer>{product.model ? 'Load 3D model' : 'Open depth display'} <Icon/></button><div class="model-stage" hidden aria-label="Interactive product display" role="img" tabindex="0"></div><div class="model-controls" hidden><button data-view="front">Front</button><button data-view="back">Back</button><button data-view="left">Rotate left</button><button data-view="right">Rotate right</button><button data-view="detail">Detail</button><button data-view="reset">Reset view</button></div><p class="model-caption" data-viewer-status role="status"></p></div>
    </div>
    <div class="product-information"><p class="mono gold">{product.collection.replaceAll('-',' ')}</p><h1>{product.title}</h1><p class="product-subtitle">{product.subtitle}</p><p class="product-price"><small>{labels.price}</small><span data-selected-price>{formatMoney(product.price)}</span></p>
      {isDemoMode && <p class="demo-box"><strong>CONCEPT PREVIEW</strong>Save your preferred options for launch. No order, payment, or stock reservation.</p>}
      <form id="product-options" class="purchase-form" tabindex="-1" data-add-form={product.handle}><fieldset><legend>Size</legend><div class="variant-options">{product.sizes.map((size,i)=><label><input type="radio" name="size" value={size} checked={product.sizes.length===1} required/><span>{size}</span></label>)}</div></fieldset><fieldset><legend>Color</legend><div class="variant-options">{product.colors.map((color,i)=><label><input type="radio" name="color" value={color} checked={i===0}/><span>{color}</span></label>)}</div></fieldset><label>Quantity<input type="number" min="1" max="99" name="quantity" value="1" inputmode="numeric" required/></label><p class="availability" data-variant-status>{isDemoMode ? 'Concept options — final measurements and availability pending.' : 'Select your preferred options.'}</p><button class="button" type="submit" aria-label={labels.save}>{labels.save} <Icon/></button><button class="button secondary" type="button" data-buy-now>{labels.action}</button><p class="form-status" role="status" data-purchase-status></p></form>
      <ProductDevelopment product={product} isDemoMode={isDemoMode}/>
      <p class="product-description">{product.description}</p>{character && <a class="text-link" href={href(`play/?character=${character.id}`)}>Play as {character.name} <Icon/></a>}<p class="game-product-note">The same creative world, ready to play. No purchase required.</p><button class="text-button" data-share-product>Share product</button><p class="form-status" data-share-status role="status"></p>
    </div>
  </section>
  {related.length>0 && <section class="section"><div class="section-heading"><h2>Complete your signal.</h2></div><div class="products-grid">{related.map(product=><ProductCard product={product}/>)}</div></section>}
  <div class="mobile-product-bar"><div><strong>{formatMoney(product.price)}</strong><span>{labels.price}</span></div><a class="button" href="#product-options" data-select-options>Choose Options <Icon/></a></div>
  </div>
</Shell>
