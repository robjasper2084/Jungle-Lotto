---
import Shell from '../../layouts/Shell.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductMedia from '../../components/ProductMedia.astro';
import Icon from '../../components/Icon.astro';
import { buildProvider } from '../../commerce/provider';
import { characters } from '../../content/catalog';
import { formatMoney, precision } from '../../commerce/money';
import { href, media, canonical } from '../../utilities/paths';
export async function getStaticPaths(){return (await buildProvider.getProducts()).map(product=>({params:{handle:product.handle},props:{product}}));}
const { product }=Astro.props;
const related=(await buildProvider.getProducts()).filter(p=>p.handle!==product.handle && (p.collection===product.collection || p.productType===product.productType)).slice(0,3);
const character=characters.find(c=>c.id===product.characterAssociation);
const schema = [{'@context':'https://schema.org','@type':'Product',name:product.title,description:product.description,image:product.images.map(im=>new URL(media(im.src),canonical()).href),brand:{'@type':'Brand',name:'GOTHTECHNOLOGY'},...(product.demo ? {} : {offers:{'@type':'Offer',price:product.price.amount/(10**precision(product.price.currency)),priceCurrency:product.price.currency,url:canonical(`products/${product.handle}/`),availability:product.variants.some(v=>v.available)?'https://schema.org/InStock':'https://schema.org/OutOfStock'}})}, {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Shop',item:canonical('shop/')},{'@type':'ListItem',position:2,name:product.title,item:canonical(`products/${product.handle}/`)}]}];
---
<Shell title={product.seo.title} description={product.seo.description} path={`products/${product.handle}/`} schema={schema}>
  <div class="product-route"><nav class="breadcrumb" aria-label="Breadcrumb"><a href={href('shop/')}>Shop</a><span>/</span><a href={href(`collections/${product.collection}/`)}>{product.collection.replaceAll('-',' ')}</a><span>/</span><span>{product.title}</span></nav>
  <section class="section product-detail" data-product-detail={product.handle}>
    <div class="product-gallery">{product.images.length ? <><div class="gallery-main"><img id="gallery-image" src={media(product.images[0].src)} alt={product.images[0].alt} width="840" height="840" fetchpriority="high"/>{product.demo && <span class="media-caption">SUPPLIED PRODUCT REFERENCE</span>}<button id="gallery-zoom" aria-pressed="false">Zoom image</button></div><div class="gallery-thumbs" aria-label="Product image views">{product.images.map((im,i)=><button type="button" data-gallery-src={media(im.src)} data-gallery-alt={im.alt} aria-pressed={i===0}><img src={media(im.src)} alt="" width="140" height="85" loading="lazy"/>{im.label}</button>)}</div></> : <ProductMedia product={product} priority/>}
      <div class="model-viewer" data-model={product.model || ''} data-handle={product.handle}><h3>Explore the display.</h3><p class="model-caption">{product.model ? 'Drag, touch, or use the view controls to rotate the product model.' : 'A 2.5D image display, not a garment model. The supplied product gallery remains the reference.'}</p><button class="text-button" data-load-viewer>{product.model ? 'Load 3D model' : 'Open depth display'} <Icon/></button><div class="model-stage" hidden aria-label="Interactive product display" role="img" tabindex="0"></div><div class="model-controls" hidden><button data-view="front">Front</button><button data-view="back">Back</button><button data-view="left">Rotate left</button><button data-view="right">Rotate right</button><button data-view="detail">Detail</button><button data-view="reset">Reset view</button></div><p class="model-caption" data-viewer-status role="status"></p></div>
    </div>
    <div class="product-information"><p class="mono gold">{product.collection.replaceAll('-',' ')}</p><h1>{product.title}</h1><p class="product-subtitle">{product.subtitle}</p><p class="product-price" data-selected-price>{formatMoney(product.price)}</p>
      {product.demo && <p class="demo-box"><strong>DEMO PRODUCT</strong>Concept catalog and supplied references. No physical or digital items are fulfilled from this preview.</p>}
      <form id="product-options" class="purchase-form" data-add-form={product.handle}><fieldset><legend>Size</legend><div class="variant-options">{product.sizes.map((size,i)=><label><input type="radio" name="size" value={size} checked={i===0}/><span>{size}</span></label>)}</div></fieldset><fieldset><legend>Color</legend><div class="variant-options">{product.colors.map((color,i)=><label><input type="radio" name="color" value={color} checked={i===0}/><span>{color}</span></label>)}</div></fieldset><label>Quantity<input type="number" min="1" max="99" name="quantity" value="1" inputmode="numeric" required/></label><p class="availability" data-variant-status>{product.demo ? 'Demo options — real inventory is not connected.' : 'Select your preferred options.'}</p><button class="button" type="submit" aria-label="Add this item to shopping cart">Add to Loadout <Icon/></button><button class="button secondary" type="button" data-buy-now>Proceed to checkout</button><p class="form-status" role="status" data-purchase-status></p></form>
      <div class="product-accordions"><details><summary>Size guide</summary><p>{product.demo ? `Final measurements are not supplied. Demo size labels: ${product.sizes.join(' / ')}. These are not a verified size chart. Confirm measurements with the owner before buying.` : 'Consult the product description for measurements. Contact the store if your fit is not clear.'}</p></details><details><summary>Materials & construction</summary><p>{product.materials}</p><p>{product.fabricWeight}</p><p>{product.finish}</p></details><details><summary>Care instructions</summary><p>{product.careInstructions}</p></details><details><summary>Shipping & returns</summary><p>{product.shippingMessage}</p><p>{product.returnMessage}</p><p><a class="text-link" href={href('shipping/')}>Shipping details</a> / <a class="text-link" href={href('returns/')}>Returns policy</a></p></details>{product.digital && <details><summary>Digital delivery</summary><p>Digital contents, file formats, license, and delivery method must be confirmed before this concept can be sold. No download is delivered by demo checkout.</p></details>}</div>
      <p class="product-description">{product.description}</p>{character && <a class="text-link" href={href(`play/?character=${character.id}`)}>Play as {character.name} <Icon/></a>}<br/><button class="text-button" data-share-product>Share product</button><p class="form-status" data-share-status role="status"></p>
    </div>
  </section>
  {related.length>0 && <section class="section"><div class="section-heading"><h2>Complete your signal.</h2></div><div class="products-grid">{related.map(product=><ProductCard product={product}/>)}</div></section>}
  <div class="mobile-product-bar"><div><strong>{formatMoney(product.price)}</strong><span>{product.demo?'Demo price':'Starting price'}</span></div><a class="button" href="#product-options" data-select-options>Select options <Icon/></a></div>
  </div>
</Shell>
