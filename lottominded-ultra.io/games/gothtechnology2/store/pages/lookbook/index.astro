import Shell from '../../layouts/Shell.astro';
import Newsletter from '../../components/Newsletter.astro';
import {href} from '../../utilities/paths';
---
<Shell title="Combat Lookbook" path="lookbook/" description="Detroit embroidery, the LottoMind companion, and the imagined GOTHTECHNOLOGY world. An editorial collection of supplied references.">
<header class="page-heading"><span class="section-number">VISUAL ARCHIVE / VOL. 001</span><h1>Carry the city.<br/>Build your world.</h1><p>Product references, close details, and imagined worlds. A visual direction for the first transmission.</p></header>
<section class="section lookbook-grid"><figure><a href={href('products/gothtechnology-luggage-charm/')}><img src={href('media/charm-campaign.webp')} alt="LottoMind charm campaign concept on a dark gold-edged display" width="1000" height="1000"/></a><figcaption>01 / THE COMPANION — CAMPAIGN CONCEPT</figcaption></figure><figure><a href={href('products/night-protocol-hoodie/')}><img src={href('media/embroidery.webp')} alt="Close detail of Detroit skyline embroidery on a charcoal hoodie" width="1680" height="938" loading="lazy"/></a><figcaption>02 / THE CITY IN THREAD — SUPPLIED REFERENCE</figcaption></figure><figure><img src={href('media/charm-bags.webp')} alt="LottoMind charm and black gold strap attached to a brown backpack, showing scale and clasp placement" width="1392" height="752" loading="lazy"/><figcaption>03 / EVERYDAY SCALE — SUPPLIED REFERENCE</figcaption></figure></section>
<section class="section origin-section"><div><span class="section-number">DETROIT / EVERYDAY EQUIPMENT</span><h2>A signal<br/>that travels.</h2><p>A black strap, gold hardware, a familiar face. The supplied bag photographs guide scale and attachment placement; the bags are styling references, not confirmed bundle contents.</p><a class="text-link" href={href('products/gothtechnology-luggage-charm/')}>Explore the charm →</a><br/><button class="text-button" data-watch-transmission>Watch the 15-second charm film</button></div><img src={href('media/sling-bag.webp')} alt="Black Detroit sling bag on a cream hoodie with a LottoMind charm attached at the side" width="1376" height="768" loading="lazy"/></section>
<section class="section lookbook-grid"><figure><img src={href('media/mascot-illustration.webp')} alt="Watercolor-style LottoMind mascot in a Detroit hoodie" width="1680" height="938" loading="lazy"/><figcaption>04 / CHARACTER STUDY — SUPPLIED ART</figcaption></figure><figure><a href={href('products/static-saints-patch-set/')}><img src={href('media/patch.webp')} alt="Round black Detroit embroidered patch with gold edge, red heart, skyline, and sunrise" width="1680" height="949" loading="lazy"/></a><figcaption>05 / THE CITY AS A SYMBOL — PATCH REFERENCE</figcaption></figure><figure><img src={href('media/cap.webp')} alt="Navy Detroit cap with colorful skyline embroidery" width="1680" height="938" loading="lazy"/><figcaption>06 / EMBROIDERY REFERENCE — CAP NOT IN CATALOG</figcaption></figure></section>
<section class="section game-portal"><div><span class="section-number">BEYOND THE OBJECT</span><h2>Worlds<br/>after midnight.</h2><p>The mascot-world image is visual development art. It is not a screenshot or a promise of new game mechanics. The preserved fighting game is ready to play.</p><a class="button" href={href('play/')}>Enter the fight →</a></div><img src={href('media/mascot-world.webp')} alt="Fantasy concept art of the LottoMind mascot in a purple and gold circuit world" width="1680" height="938" loading="lazy"/></section><Newsletter/>
</Shell>
