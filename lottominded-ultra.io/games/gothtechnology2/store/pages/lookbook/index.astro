---
import Shell from '../../layouts/Shell.astro';
import Newsletter from '../../components/Newsletter.astro';
import OriginFilm from '../../components/OriginFilm.astro';
import {href} from '../../utilities/paths';
---
<Shell title="Combat Lookbook" path="lookbook/" description="Detroit embroidery, the LottoMind companion, and the imagined GOTHTECHNOLOGY world. An editorial collection of supplied references.">
<header class="page-heading"><span class="section-number">VISUAL ARCHIVE / VOL. 001</span><h1>Carry the city.<br/>Build your world.</h1><p>Product references, close details, and imagined worlds. A visual direction for the first transmission.</p></header>
<section class="section lookbook-grid lookbook-film-grid">
  <OriginFilm id="lookbook-detroit-film" source="media/lookbook-detroit-film.mp4" poster="media/lookbook-detroit-film-poster.webp" label="Detroit Lookbook film" title="01 / THE CITY IN MOTION — LOOKBOOK FILM" description="A 15-second street sequence featuring the Detroit hoodie, from a storefront to the city at dusk." buttonLabel="Lookbook film" feature/>
  <figure><a href={href('products/night-protocol-hoodie/')}><img src={href('media/detroit-sling-couple.webp')} alt="Two people wearing black Detroit hoodies in a boutique, showing a black sling bag with a LottoMind charm" width="1376" height="768" loading="lazy"/></a><figcaption>02 / CARRY DETROIT — APPAREL REFERENCE</figcaption></figure>
  <figure><img src={href('media/detroit-boutique-loadout.webp')} alt="Two people wearing Detroit hoodies in a boutique, showing a black sling bag and a packaged LottoMind charm" width="1376" height="768" loading="lazy"/><figcaption>03 / THE EVERYDAY LOADOUT — SUPPLIED REFERENCE</figcaption></figure>
</section>
<section class="section origin-section"><div><span class="section-number">DETROIT / EVERYDAY EQUIPMENT</span><h2>A signal<br/>that travels.</h2><p>A black strap, gold hardware, a familiar face. The supplied bag photographs guide scale and attachment placement; the bags are styling references, not confirmed bundle contents.</p><a class="text-link" href={href('products/gothtechnology-luggage-charm/')}>Explore the charm →</a><br/><button class="text-button" data-watch-transmission>Watch the 15-second charm film</button></div><img src={href('media/sling-bag.webp')} alt="Black Detroit sling bag on a cream hoodie with a LottoMind charm attached at the side" width="1376" height="768" loading="lazy"/></section>
<section class="section lookbook-grid lookbook-community-grid"><figure><img src={href('media/detroit-community.webp')} alt="Four people wearing Detroit hoodies and caps in a boutique, showing a green sling bag and packaged LottoMind charm" width="1376" height="768" loading="lazy"/><figcaption>04 / THE DETROIT CREW — APPAREL REFERENCE</figcaption></figure><figure class="lookbook-portrait-reference"><a href={href('products/night-protocol-hoodie/')}><img src={href('media/detroit-hoodie-portrait.webp')} alt="Two people wearing black Detroit hoodies and holding a matching embroidered hoodie" width="1200" height="1604" loading="lazy"/></a><figcaption>05 / DETROIT TOGETHER — APPAREL REFERENCE</figcaption></figure><figure><a href={href('products/black-signal-beanie/')}><img src={href('media/detroit-beanie.webp')} alt="Black Detroit beanie with colorful skyline embroidery on a dark pedestal" width="896" height="1200" loading="lazy"/></a><figcaption>06 / DETROIT BEANIE — SUPPLIED REFERENCE</figcaption></figure></section>
<section class="section game-portal"><div><span class="section-number">BEYOND THE OBJECT</span><h2>Worlds<br/>after midnight.</h2><p>The mascot-world image is visual development art. It is not a screenshot or a promise of new game mechanics. The preserved fighting game is ready to play.</p><a class="button" href={href('play/')}>Enter the fight →</a></div><img src={href('media/mascot-world.webp')} alt="Fantasy concept art of the LottoMind mascot in a purple and gold circuit world" width="1680" height="938" loading="lazy"/></section><Newsletter/>
</Shell>
<style>
  .lookbook-film-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .lookbook-community-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .lookbook-community-grid>figure:first-child{grid-column:1/-1;grid-row:auto}
  .lookbook-community-grid>figure:first-child img{display:block;height:auto;aspect-ratio:1376/768}
  .lookbook-community-grid>figure:not(:first-child){aspect-ratio:4/3;overflow:hidden}
  .lookbook-community-grid>figure:not(:first-child) img{aspect-ratio:auto}
  .lookbook-portrait-reference{background:#080a0b}
  .lookbook-portrait-reference>a{display:block;height:100%}
  .lookbook-portrait-reference img{object-fit:cover;object-position:center 24%}
  @media(max-width:680px){.game-portal h2{font-size:clamp(38px,10vw,62px)}}
</style>
