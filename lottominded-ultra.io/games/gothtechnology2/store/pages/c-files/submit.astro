---
import CFiles from '../../layouts/CFiles.astro';import { eventTypes } from '../../cfiles/types';import { href } from '../../utilities/paths';
---
<CFiles title="Submit a report" active=""><section class="cf-intro cf-narrow"><h1>Put it on the record.</h1><p>Reports are reviewed before publication. Be specific about what you observed and what remains uncertain.</p></section><form class="cf-form cf-narrow" data-report-form><div class="cf-form-grid"><label>Report title<input name="title" required minlength="5" maxlength="140" placeholder="A concise description of your observation"/></label><label>Event type<select name="event_type">{eventTypes.map(t=><option>{t}</option>)}</select></label><label>Date and time<input name="event_date" type="datetime-local" required/></label><label>Timezone<input name="timezone" required value="America/New_York" placeholder="America/New_York"/></label><label class="cf-full">Location<input name="location" required minlength="3" maxlength="160" placeholder="City, region, or general area"/></label><label>Latitude (optional)<input name="lat" type="number" min="-90" max="90" step="any"/></label><label>Longitude (optional)<input name="lon" type="number" min="-180" max="180" step="any"/></label><label>Witness type<select name="witness_type">{['Civilian','Military','Pilot','Astronomer','Other'].map(t=><option>{t}</option>)}</select></label><label>Recording equipment (optional)<input name="gear" maxlength="300" placeholder="Camera, phone, lens, or other equipment"/></label><label class="cf-full">What did you observe?<textarea name="narrative" required minlength="40" maxlength="6000" rows="6" placeholder="Describe duration, direction, motion, weather, sounds, and any ordinary explanations you considered."></textarea></label></div><label>Evidence photo (optional)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp"/><small>Up to 4 MB. Image previews are normalized and metadata is removed. Keep the original file.</small></label><p class="cf-notice">Do not include home addresses or personal contact details in your narrative. Public coordinates are rounded to protect privacy.</p><label class="cf-check"><input type="checkbox" name="consent" required/>I have permission to share this report and evidence.</label><div class="cf-form-actions"><button class="cf-button" type="submit">Submit for review</button><button class="cf-button cf-secondary" type="button" data-save-draft>Save draft on this device</button></div><p role="status" data-form-status></p><a class="cf-text-link" href={href('c-files/sources/#method')}>How review works →</a></form></CFiles>
