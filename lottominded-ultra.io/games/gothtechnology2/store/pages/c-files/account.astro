---
import CFiles from '../../layouts/CFiles.astro';
---
<CFiles title="Your research account" active=""><section class="cf-intro cf-narrow"><h1>Your place in the archive.</h1><p>Sign in to submit a report, contribute evidence, and follow its review status.</p></section><section class="cf-narrow" data-account-panel><div data-signed-out><div class="cf-tabs" role="group" aria-label="Account action"><button class="cf-text-button" data-auth-tab="login" aria-pressed="true">Sign in</button><button class="cf-text-button" data-auth-tab="signup" aria-pressed="false">Create account</button></div><form class="cf-form" data-auth-form><label data-name-field hidden>Display name<input name="name" minlength="2" maxlength="60" autocomplete="nickname"/></label><label>Email<input name="email" type="email" required autocomplete="email"/></label><label>Password<input name="password" aria-label="Password" type="password" required minlength="12" maxlength="128" autocomplete="current-password"/><small>At least 12 characters. Use a password unique to this site.</small></label><button class="cf-button" type="submit" data-auth-submit>Sign in</button><p role="status" data-form-status></p></form></div><div data-signed-in hidden><h2 data-welcome></h2><button class="cf-button cf-secondary" data-sign-out>Sign out</button><h3 class="cf-section-title">Your reports</h3><div data-my-reports></div></div></section></CFiles>
