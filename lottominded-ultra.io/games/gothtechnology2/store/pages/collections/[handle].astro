---
import Shell from '../../layouts/Shell.astro';
import Filters from '../../components/Filters.astro';
import ProductCard from '../../components/ProductCard.astro';
import { buildProvider } from '../../commerce/provider';
import { characters } from '../../content/catalog';
import { conversionMode } from '../../commerce/mode';
import { href } from '../../utilities/paths';
export async function getStaticPaths() { const all=await buildProvider.getCollections();return all.map(collection=>({params:{handle:collection.handle},props:{collection}})); }
const { collection }=Astro.props;
const products=await buildProvider.getProducts();
const isDemoMode=conversionMode(products)==='interest';
const campaign=products.find(p=>p.collections.includes(collection.handle) && p.images.length)?.images[0];
const character=characters.find(c=>c.collection===collection.handle);
---
<Shell title={collection.title} path={`collections/${collection.handle}/`} description={collection.description} socialImage={campaign?.src}><header class="page-heading" data-collection-page={collection.handle}><span class="section-number">COLLECTION / THE ARMORY</span><h1>{collection.title}.</h1><p>{collection.description}</p><p class="collection-status">{isDemoMode ? 'Concept Preview · Product details are in development.' : 'Explore the approved collection.'}</p>{character && <a class="button secondary" href={href(`play/?character=${character.id}`)}>Play as {character.name}</a>}</header><section class="collection-world section"><div><h2>From fighter to everyday signal.</h2><p>Each collection carries a visual theme from the GOTHTECHNOLOGY world into proposed apparel and artifacts. Collecting is optional; the game is free.</p><a class="text-link" href={href('lookbook/')}>Explore the campaign lookbook →</a></div>{character && <a href={href(`play/?character=${character.id}`)}><img src={href('assets/user-roster/'+character.image)} alt={character.name+' — game character artwork'} width="256" height="256" loading="lazy"/><span class="text-link">Play as {character.name} · No purchase required</span></a>}</section><section class="section catalog-section"><Filters activeCollection={collection.handle}/><div class="products-grid" id="product-grid">{products.map(product=><div hidden={!product.collections.includes(collection.handle)} data-product-wrapper><ProductCard product={product}/></div>)}</div></section></Shell>
