---
import Shell from '../layouts/Shell.astro';
import { supportPages, getSupportPage } from '../content/support';
import { buildProvider } from '../commerce/provider';
import { conversionMode } from '../commerce/mode';
import { href } from '../utilities/paths';
export function getStaticPaths(){return Object.entries(supportPages).map(([page,content])=>({params:{page},props:{content,page}}));}
const {page}=Astro.props;
const content=getSupportPage(page, conversionMode(await buildProvider.getProducts()) === 'commerce');
---
<Shell title={content.title} description={content.intro} path={`${page}/`}>
<article class="section document-page"><span class="section-number">GOTHTECHNOLOGY / SUPPORT</span><h1>{content.title}</h1><p class:list={['shipping','returns','terms','privacy'].includes(page)?'policy-notice':''}>{content.intro}</p>
{content.sections.map(([title,text])=><section><h2>{title}</h2><p>{text}</p></section>)}
<p><a href={href('shop/')}>Browse the armory</a> / <a href={href('play/')}>Play GOTHTECHNOLOGY</a></p>
</article></Shell>
